// ------------------------------------------------------------
// 1. DEFINE ROI (optional starting area)
// ------------------------------------------------------------
var roi = ee.Geometry.Rectangle([
  -159.530134, 67.629498,
  -159.502206, 67.652005
]);
 
// ------------------------------------------------------------
// BEST AVAILABLE HIGH-RESOLUTION HISTORICAL IMAGERY
// Similar appearance to default Google basemap
// Uses Sentinel-2 cloud-free composites

// ------------------------------------------------------------
// 2. LOAD 2020 SENTINEL-2 IMAGE
// ------------------------------------------------------------
// This is the closest reliable public equivalent to the
// Google/Maxar/Airbus basemap available inside GEE.

var s2_2020 = ee.ImageCollection('COPERNICUS/S2_HARMONIZED')
  .filterBounds(roi)
  .filterDate('2020-06-01', '2020-09-30')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 10))
  .sort('CLOUDY_PIXEL_PERCENTAGE')
  .median();

// ------------------------------------------------------------
// 3. VISUALISATION
// ------------------------------------------------------------
var vis = {
  bands: ['B4', 'B3', 'B2'],
  min: 0,
  max: 2500,
  gamma: 1.2
};

Map.centerObject(roi, 13);

Map.addLayer(s2_2020, vis, 'Sentinel-2 2020');

// ------------------------------------------------------------
// 4. OPTIONAL: 2017 COMPARISON
// ------------------------------------------------------------
var s2_2017 = ee.ImageCollection('COPERNICUS/S2_HARMONIZED')
  .filterBounds(roi)
  .filterDate('2017-06-01', '2017-09-30')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 10))
  .sort('CLOUDY_PIXEL_PERCENTAGE')
  .median();

Map.addLayer(s2_2017, vis, 'Sentinel-2 2017', false);

// ------------------------------------------------------------
// 5. DRAW POLYGON
// ------------------------------------------------------------
// Use the drawing tool on Google Earth Engine.
// Draw directly over the rusted river section.
//
// Rename resulting geometry:
// river_mask_A 
//
// Toggle 2017 vs 2020 layers to compare rusting.

// ------------------------------------------------------------
// 2. DATASET
// ------------------------------------------------------------
var dataset = ee.ImageCollection('GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL')
  .filterBounds(roi);

// ------------------------------------------------------------
// 3. RIVER MASK (WORKING VERSION YOU CONFIRMED)
// ------------------------------------------------------------
var riverMask = ee.Image.constant(1)
  .clip(river_mask_Control_4)
  .selfMask();

// ------------------------------------------------------------
// 4. APPLY MASK (KEEP EXACTLY AS WORKING)
// ------------------------------------------------------------
var prepared = dataset.map(function(img) {

  return img
    .updateMask(riverMask)
    .clip(roi);
});

// ------------------------------------------------------------
// 5. VISUALISE SAMPLE (UNCHANGED, SAFE)
// ------------------------------------------------------------
var vis = {
  min: -0.3,
  max: 0.3,
  bands: ['A01', 'A16', 'A09']
};

var sample = prepared.sort('system:time_start', false).first();

Map.centerObject(roi, 11);
Map.addLayer(sample, vis, 'Latest embeddings');
Map.addLayer(riverMask, {palette: ['blue']}, 'River mask');

// ------------------------------------------------------------
// 6. STACK ALL YEARS + ALL 64 BANDS INTO ONE IMAGE
// ------------------------------------------------------------

var stacked = prepared.map(function(img) {

  var year = ee.Date(img.get('system:time_start')).format('YYYY');
  var bands = img.bandNames();

  return img.select(
    bands,
    bands.map(function(b) {
      return ee.String(year).cat('_').cat(b);
    })
  );
}).toBands();

// ------------------------------------------------------------
// 7. SINGLE EXPORT (NO LOOP, ONE TASK)
// ------------------------------------------------------------
Export.image.toDrive({
  image: stacked,
  description: 'AlphaEarth_ALL_YEARS_RIVER_64BANDS',
  folder: 'AlphaEarth',
  fileNamePrefix: 'alphaearth_all_years_river_64bands',
  region: roi,
  scale: 10,
  fileFormat: 'GeoTIFF',
  maxPixels: 1e13
});
